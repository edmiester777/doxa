[package]
name = "__name__-web"
version = "0.1.0"
edition = "2021"
publish = false

[lib]
crate-type = ["cdylib", "rlib"]

[package.metadata.doxa]
role = "client"
server = "__name__-api"
css = ["style/app.css"]
css_sources = []
public = "public"

# npm packages the UI imports:
# [package.metadata.doxa.npm]
# "@monaco-editor/react" = "^4.7"
# react = "^19"

[dependencies]
__name__-api = { path = "../api" }
doxa = { version = "__doxa_version__", features = ["ui"] }
# Pinned to the version `doxa build` generates bindings with.
wasm-bindgen = "=__wasm_bindgen_version__"
