[package]
name = "{{name}}-client"
version = "0.1.0"
edition = "2021"
publish = false

# The same source as `{{name}}-api`, compiled as the client half.
[lib]
path = "../api/src/lib.rs"

[dependencies]
doxa = { version = "{{doxa_version}}", features = ["client"] }
serde = { version = "1", features = ["derive"] }

[build-dependencies]
doxa-role = "{{doxa_version}}"
