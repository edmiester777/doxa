[package]
name = "{{name}}-api"
version = "0.1.0"
edition = "2021"
publish = false

# The routes, declared: built for the server and for the browser.
[dependencies]
doxa = { version = "{{doxa_version}}", features = ["client"] }
serde = { version = "1", features = ["derive"] }
utoipa = "5"

[build-dependencies]
doxa-role = "{{doxa_version}}"
